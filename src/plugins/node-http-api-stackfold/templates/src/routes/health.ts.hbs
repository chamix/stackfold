import type { Router } from '../router.js';
import { reply } from '../types.js';

/** GET /health (liveness) and GET /ready (readiness). Neither needs a body or credentials. */
export function registerHealthRoutes(router: Router, isReady: () => boolean): void {
  router.get('/health', () => ({ status: 'ok' }));
  router.get('/ready', () => (isReady() ? { status: 'ready' } : reply(503, { status: 'not_ready' })));
}
