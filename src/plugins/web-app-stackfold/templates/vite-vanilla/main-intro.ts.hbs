// Deliberately duplicates main.ts.hbs's own DOM-building logic (mount, <h1>, textContent) rather than sharing it — this codebase has no registerPartial() precedent (regla de tres); keep the two in sync by hand if the bare version's structure changes.
const APP_NAME = "{{appName}}";

export function renderApp(container: HTMLElement): void {
  const main = document.createElement('main');

  const heading = document.createElement('h1');
  heading.textContent = APP_NAME;
  main.appendChild(heading);

  const img = document.createElement('img');
  img.style.width = '96px';
  img.style.height = 'auto';
  img.style.display = 'block';
  img.src =
    "data:image/webp;base64,";
  img.alt = 'Stackfold';
  main.appendChild(img);

  const introLink = document.createElement('a');
  introLink.href = 'https://github.com/chamix/stackfold';
  introLink.textContent = 'Stackfold';

  const introPara = document.createElement('p');
  introPara.append(
    'Built with ',
    introLink,
    ". Stackfold's job ends here — there's no watcher, no re-generation, nothing left to run."
  );
  main.appendChild(introPara);

  const notePara = document.createElement('p');
  notePara.textContent =
    'Edit this file (and everything else in this project) freely from here on. Replace this block whenever you\'re ready.';
  main.appendChild(notePara);

  container.replaceChildren(main);
}

const root = document.getElementById('app');
if (root) renderApp(root);
