{
  "name": "stackfold",
  "version": "1.0.0",
  "description": "Stack-agnostic scaffolding CLI with a plugin-based generator system.",
  "main": "./dist/core/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-templates.mjs",
    "dev": "tsx src/cli/index.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e:playground": "node scripts/e2e-playground.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "scaffolding",
    "cli",
    "generator",
    "plugin",
    "electron",
    "typescript"
  ],
  "author": "Camilo Vera",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "execa": "^10.0.1",
    "handlebars": "^4.7.10",
    "json-logic-js": "^2.0.5",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/vue": "^8.1.0",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/compiler-sfc": "^3.5.44",
    "electron": "^44.4.5",
    "eslint": "^10.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.44"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chamix/stackfold.git"
  },
  "bugs": {
    "url": "https://github.com/chamix/stackfold/issues"
  },
  "homepage": "https://github.com/chamix/stackfold#readme",
  "bin": {
    "stackfold": "dist/cli/index.js"
  }
}
